            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why not cost per story point?",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2933",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Points are team-relative estimates: 5 points in one team is not 5 in another.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Once targeted, points inflate (Goodhart's law).",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Output, not outcome: ignores quality and benefits.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use earned value: CPI = EV ÷ AC, SPI = EV ÷ PV. Money-based, comparable, reconcilable to the ledger.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1F2933"
                    }
                  }
                ]
              }
            ]
